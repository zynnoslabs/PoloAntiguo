# Variables de entorno para Polo Antiguo Buscador
# Copiar como .env (nunca subir al repo)

# OBLIGATORIO — Groq (gratis en console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# OPCIONAL — SerpApi (gratis 250/mes en serpapi.com)
SERPAPI_KEY=

# OPCIONAL — eBay Browse API (gratis, registro en developer.ebay.com)
EBAY_TOKEN=

# Clave para disparar búsqueda manual vía POST /api/trigger
TRIGGER_SECRET=polo2024

# Ruta de la DB (por defecto /tmp/db.sqlite en local, /data/db.sqlite en Render)
DB_PATH=/tmp/db.sqlite

# Puerto (Render lo asigna automáticamente)
PORT=5000
